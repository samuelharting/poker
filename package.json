{
  "name": "poker-night",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"npx partykit dev\"",
    "dev:next": "next dev",
    "dev:party": "npx partykit dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "smoke:e2e": "playwright test e2e/private-table-smoke.spec.ts --browser=chromium --reporter=line",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run test && npm run typecheck && npm run build && npm run audit:prod",
    "deploy:partykit": "npx partykit deploy",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.18.0",
    "next": "^15.5.18",
    "partysocket": "^1.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.27.0",
    "partykit": "^0.0.115",
    "postcss": "^8.5.15",
    "react-test-renderer": "^19.2.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  }
}
